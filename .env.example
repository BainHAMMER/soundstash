# Working directory for input/output track lists (use "." for project root or "local" for a subfolder)
DATA_DIR=.

# Audio format:
# mp3  - 320 kbps CBR (maximum compatibility across all players)
# opus - native YouTube audio stream without transcoding (~160-256 kbps, best true quality)
# m4a  - AAC stream without transcoding
# flac - lossless container
AUDIO_FORMAT=mp3
AUDIO_QUALITY=0

# Output folder for downloaded tracks (relative to DATA_DIR) and parallel worker count
DOWNLOAD_FOLDER=downloads
MAX_CONCURRENT_DOWNLOADS=4

# Embed cover art thumbnail and ID3/container metadata tags
EMBED_THUMBNAIL=true
ADD_METADATA=true

